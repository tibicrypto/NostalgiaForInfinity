================================================================================
INDICATORS REQUIRED
================================================================================

1h Timeframe Indicators (informative_1h):
------------------------------------------
  • RSI_14 = pta.rsi(close, length=14)
  • scalp_ema = pta.ema(close, length=100)
  • scalp_rsi = pta.rsi(close, length=14)

15m Timeframe Indicators (informative_15m):
--------------------------------------------
  • BB Bands: bbands = pta.bbands(close, length=20)
    - scalp_bb_upper = BBU_20_2.0
    - scalp_bb_lower = BBL_20_2.0
    - scalp_bb_mid = BBM_20_2.0
  • scalp_bbw = (scalp_bb_upper - scalp_bb_lower) / scalp_bb_mid
  • scalp_bbw_min = scalp_bbw.rolling(window=100).quantile(0.20)
  • scalp_vol_ma = pta.sma(volume, length=20)

5m Timeframe Indicators (base):
--------------------------------
  • BB Bands: bbands = pta.bbands(close, length=20)
    - scalp_bb_upper_5m = BBU_20_2.0
    - scalp_bb_lower_5m = BBL_20_2.0
  • scalp_rsi_5m = pta.rsi(close, length=14)
  • scalp_vol_ma_5m = pta.sma(volume, length=20)
  • scalp_atr_5m = pta.atr(high, low, close, length=14)


